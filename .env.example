JWT_SECRET=

# Secreto compartido con ninesys-api para validar su MISMO JWT de sesión de
# usuario (auditoría de seguridad 2026-09-10, cierra los hallazgos C5/C6 --
# ver [[project_fase_seguridad_pendiente]]). Debe ser EXACTAMENTE el mismo
# valor que JWT_SECRET en el .env de ninesys-api. Usado por
# authenticateToken.js/authenticateSendCustom.js para las llamadas que
# vienen de app_multi (navegador); JWT_SECRET (arriba) sigue siendo el
# propio de msg_ninesys, usado por el flujo de servicio de WhatsAppAPIClient.
NINESYS_API_JWT_SECRET=
API_URL=https://api.ninesys19.com
APP_URL=
PORT=3000

# Credencial del "gestor" (loginManager) -- usada por ninesys-api
# (WhatsAppAPIClient) para autenticarse y por el panel admin de app_multi.
# Antes hardcodeada en el código ('admin'/'Ninesys@2024', filtrada en el
# bundle público de app_multi) -- ver auditoría de seguridad 2026-09-09.
# Debe coincidir con la columna empresas.ws_username/ws_password de la BD
# central para cada empresa.
WS_MANAGER_USERNAME=
WS_MANAGER_PASSWORD=

# URL del CDN. Usada por galleryClient para pedir imágenes de galería Y para
# validar que una URL de imagen que la IA quiere enviar por WhatsApp vino
# realmente del CDN (ver src/services/waManager.js) -- si esta variable no
# coincide con el CDN_URL real de ninesys-cdn, la IA deja de mandar imágenes
# de galería en silencio, sin ningún error visible.
CDN_URL=https://cdn.ninesys19.com

# URL del endpoint de ninesys-api que arma y envía un mensaje interno
# (notificación por WhatsApp iniciada por el sistema, no por un cliente).
INTERNAL_MSG_URL=https://api.ninesys19.com/ws/build-message/interno

# Lista de orígenes permitidos para el WebSocket (separados por coma). Si se
# deja vacía, websocket.js usa una lista por defecto que ya incluye
# app.ninesys19.com y app.nineteengreen.com.
# ALLOWED_ORIGINS=https://app.ninesys19.com,https://app.nineteengreen.com

# Token compartido con ninesys-api para resolver credenciales de tenants
# vía GET {API_URL}/internal/db-credentials/{id_empresa}
MSG_SERVICE_INTERNAL_TOKEN=

# Token dedicado para la app externa 19print (dtf.ninesys19.com) --
# identifica esa integración puntual en POST /send-message-custom/:companyId
# sin usar el login admin de uso general (ver middleware/authenticateSendCustom.js).
DTF_APP_TOKEN=

# IA (Fase 8). Gemini es el proveedor por defecto. Reutilizar la misma
# GEMINI_API_KEY que usa el chat con IA del frontend (ninesys-api).
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.5-flash

# Anthropic queda como proveedor pluggable opcional (no cableado en Fase 8).
ANTHROPIC_API_KEY=

# STT — transcripción de notas de voz con OpenAI Whisper (migración 009).
# Si OPENAI_API_KEY queda vacía, sttService.transcribe lanza error y la nota
# de voz pasa por el fallback normal (sin transcript). El precio vigente está
# hardcoded en src/services/sttService.js (WHISPER_USD_PER_MINUTE).
OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
# WHISPER_TIMEOUT_MS=60000

# Logging estructurado (Fase 9.1). En desarrollo dejar NODE_ENV vacío para
# usar pino-pretty (output coloreado). En producción NODE_ENV=production
# emite JSON puro a stdout (PM2/journald lo capturan).
# LOG_LEVEL: trace|debug|info|warn|error|fatal (default: debug en dev, info en prod)
LOG_LEVEL=info
# NODE_ENV=production
